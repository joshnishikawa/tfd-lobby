# Server Configuration
PORT=4002
NODE_ENV=development

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:4000,http://localhost:4002

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tfd_user
DB_PASSWORD=dev_secret_password
DB_NAME=tfd_lobby

# TFD Task Manager Sandbox Publishing & Admin Verification
SANDBOX_PUBLISH_SECRET=replace-with-shared-hmac-secret
TFD_AUTH_DB=TFD
# TFD_AUTH_VERIFY_URL=https://theflyingdutchmen.games/api/me
ENFORCE_ADMIN_SESSION=false
